# Example configuration file for launch-expo.sh
# Copy this to .env and customize with your values

# GitHub Configuration
GITHUB_TOKEN="ghp_your_personal_access_token_here"

# Git User Configuration (prevents auto-generated commits)
GIT_USER_NAME="Your Github user name"
GIT_USER_EMAIL="your-email@example.com"

# Git Branch Names (optional, defaults shown)
GIT_DEVELOPMENT_BRANCH="development"
GIT_PRODUCTION_BRANCH="production"

# Project definitions
# Format: "project-name|github-repo-url"
PROJECTS=(
    "expoTestApp|https://github.com/CaseyShimata/expoTestApp.git"
    "myAwesomeApp|https://github.com/CaseyShimata/myAwesomeApp.git"
    "anotherProject|https://github.com/CaseyShimata/anotherProject.git"
)

# Note: This file should be encrypted with git-crypt if it contains sensitive tokens
# Run: git-crypt init && git-crypt add-gpg-user <YOUR_KEY_ID>
